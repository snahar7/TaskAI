# Copy this file to .env and fill in your own values. Never commit .env.

# --- Server ---
NODE_ENV=development
PORT=5000
# Neon: postgresql://user:pass@ep-xxx.us-east-2.aws.neon.tech/neondb?sslmode=require
# Local (docker compose up -d): postgresql://taflo:taflo@localhost:5432/taflo
DATABASE_URL=postgresql://taflo:taflo@localhost:5432/taflo
# Optional: force the driver (auto-detects Neon by hostname)
# DATABASE_DRIVER=pg
OPENAI_API_KEY=sk-your-openai-api-key-here
SESSION_SECRET=replace-with-a-long-random-string

# --- Firebase web app (client, required) ---
# Firebase console > Project settings > Your apps > Web app > SDK config
VITE_FIREBASE_API_KEY=your-firebase-web-api-key
VITE_FIREBASE_AUTH_DOMAIN=your-project-id.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=your-project-id
VITE_FIREBASE_STORAGE_BUCKET=your-project-id.firebasestorage.app
VITE_FIREBASE_MESSAGING_SENDER_ID=your-sender-id
VITE_FIREBASE_APP_ID=your-app-id
# Optional: enables Firebase Analytics
VITE_FIREBASE_MEASUREMENT_ID=

# --- Firebase Admin (server, optional; falls back to Postgres storage) ---
FIREBASE_PROJECT_ID=your-project-id
# Full service-account JSON on one line
FIREBASE_SERVICE_ACCOUNT_KEY=
